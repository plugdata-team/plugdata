{
  "title": [
    "tempo~"
  ],
  "description": "metronome",
  "origin": "ELSE",
  "categories": [
    "Triggers and Clocks"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "gate (on/off)"
        },
        {
          "type": "bang",
          "description": "sync the metronome"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "tempo in ms or bpm"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "swing deviation parameter (in %)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "an impulse syncs the metronome"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "impulses at metronome beat"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "signals",
          "description": "the tempo's phase output"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "bpm/Hz/ms",
      "default": "0"
    },
    {
      "type": "float",
      "description": "swing deviation in %",
      "default": "0"
    },
    {
      "type": "float",
      "description": "swing cycle",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "-on",
      "description": "initially turn it on"
    },
    {
      "name": "-ms",
      "description": "sets time measure to ms (default bpm)"
    },
    {
      "name": "-hz",
      "description": "sets time measure to Hz (default bpm)"
    },
    {
      "name": "-mul <float>",
      "description": "sets multiplier (default 1)"
    },
    {
      "name": "-sync",
      "description": "sets to sync mode"
    },
    {
      "name": "-seed <float>",
      "description": "sets seed (default no float sets a unique internal)"
    }
  ],
  "methods": [
    {
      "type": "mul <float>",
      "description": "sets multiplier"
    },
    {
      "type": "start",
      "description": "control rate start (gate on)"
    },
    {
      "type": "stop",
      "description": "control rate stop (gate off)"
    },
    {
      "type": "set <float>",
      "description": "set tempo in bpm, hz or ms for the next beat"
    },
    {
      "type": "ms <float, float>",
      "description": "sets time to ms, optional floats set tempo and swing"
    },
    {
      "type": "hz <float, float>",
      "description": "sets time to Hz, optional floats set tempo and swing"
    },
    {
      "type": "bpm <float, float>",
      "description": "sets time to bpm, optional floats set tempo and swing"
    },
    {
      "type": "sync <float>",
      "description": "nonzero sets to sync mode"
    },
    {
      "type": "seed <float>",
      "description": "a float sets seed, no float sets a unique internal"
    },
    {
      "type": "tempo <float>",
      "description": "set tempo in bpm, hz or ms"
    },
    {
      "type": "swing <float, float>",
      "description": "set swing deviation parameter (in %)"
    },
    {
      "type": "cycle <float>",
      "description": "set swing cycle"
    }
  ],
  "body": "The [tempo~] object is like [imp~], but sends impulses at a time specified in bpm as in a metronome and is turned on/off by a gate input."
}