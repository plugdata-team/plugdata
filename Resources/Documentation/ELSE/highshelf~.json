{
  "title": [
    "highshelf~"
  ],
  "description": "highshelf filter",
  "origin": "ELSE",
  "categories": [
    "Filters",
    "Mixing and Routing"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "signal to be filtered"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "shelving frequency in Hz"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "slope (from 0 to 1)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "gain in dB"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "filtered signal"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "shelving frequency in Hz",
      "default": "0"
    },
    {
      "type": "float",
      "description": "slope from 0 to 1",
      "default": "0"
    },
    {
      "type": "float",
      "description": "gain in dB",
      "default": "0"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "freq <list>",
      "description": "shelving frequency in Hz for each channel"
    },
    {
      "type": "slope <list>",
      "description": "filter slope for each channel"
    },
    {
      "type": "db <list>",
      "description": "gain in dB for each channel"
    },
    {
      "type": "clear",
      "description": "clears filter's memory if you blow it up"
    },
    {
      "type": "bypass <float>",
      "description": "1 (bypasses input signal) or 0 (doesn't bypass)"
    }
  ],
  "body": "[highshelf~] is a 2nd order highshelf filter."
}