{
  "title": [
    "pan~"
  ],
  "description": "circular panning over given number of channels",
  "origin": "ELSE",
  "categories": [
    "Mixing and Routing"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "signal input"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "gain parameter"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "pan position from 0 to 1"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "spread parameter, minimum 0.1"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "equal power panned output $nth"
        }
      ],
      "repeat": true
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "number of output channels (min 2, max 4096)",
      "default": "2"
    },
    {
      "type": "float",
      "description": "spread",
      "default": "1"
    },
    {
      "type": "float",
      "description": "position offset from 0 to 1",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "-open",
      "description": "set to open mode (default circular)"
    },
    {
      "name": "-cartesian",
      "description": "sets to cartesian mode"
    }
  ],
  "methods": [
    {
      "type": "open <float>",
      "description": "sets to open mode"
    },
    {
      "type": "offset <float>",
      "description": "sets position offset from 0 to 1"
    },
    {
      "type": "cartesian <float>",
      "description": "nonzero sets cartesian mode"
    },
    {
      "type": "pos <list>",
      "description": "position value(s)"
    },
    {
      "type": "gain <list>",
      "description": "gain value(s)"
    },
    {
      "type": "spread <list>",
      "description": "spread value(s)"
    }
  ],
  "body": "[pan~] pans an input signal to 'n' outlets, with equal power crossfading between adjacent channels according to a spread parameter. The speakers are assumed to be in a circle with equal angles between them, so the position input goes around the circle: it ranges from 0 to 1, where 1 is the same as 0."
}