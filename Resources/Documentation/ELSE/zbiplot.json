{
  "title": [
    "zbiplot"
  ],
  "description": "z-plane biquad plot",
  "origin": "ELSE",
  "categories": [
    "UI",
    "Filters"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "outputs the coefficients"
        },
        {
          "type": "list",
          "description": "pole coordinates as re/im pairs, or 2 poles then 2 zeros as 8 values"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "list",
          "description": "zero coordinates as re/im pairs"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "list",
          "description": "biquad coefficients, 5 per section in [biquad~] order"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [
    {
      "name": "-size <float>",
      "description": "sets width and height in pixels (default 200)"
    },
    {
      "name": "-order <float>",
      "description": "sets the number of poles and zeros, even from 2 to 128 (default 2)"
    },
    {
      "name": "-savestate",
      "description": "sets to save state mode"
    },
    {
      "name": "-bgcolor <symbol>",
      "description": "background color in hexadecimal (default #FFFFFF)"
    },
    {
      "name": "-fgcolor <symbol>",
      "description": "axis and unit circle color in hexadecimal (default #000000)"
    },
    {
      "name": "-polecolor <symbol>",
      "description": "pole color in hexadecimal (default #DC2828)"
    },
    {
      "name": "-zerocolor <symbol>",
      "description": "zero color in hexadecimal (default #2828DC)"
    },
    {
      "name": "-theme",
      "description": "uses Pd's theme colors"
    },
    {
      "name": "-transparent",
      "description": "makes the background transparent"
    }
  ],
  "methods": [
    {
      "type": "coeff <list>",
      "description": "sets the plot from one or more groups of 5 [biquad~] coefficients"
    },
    {
      "type": "set <list>",
      "description": "same as the list message"
    },
    {
      "type": "size <float>",
      "description": "sets width and height in pixels"
    },
    {
      "type": "order <float>",
      "description": "sets the number of poles and zeros, even from 2 to 128 (no output)"
    },
    {
      "type": "savestate <float>",
      "description": "nonzero sets to save state mode"
    },
    {
      "type": "bgcolor <anything>",
      "description": "sets background color as RGB list or symbol"
    },
    {
      "type": "fgcolor <anything>",
      "description": "sets axis and unit circle color as RGB list or symbol"
    },
    {
      "type": "polecolor <anything>",
      "description": "sets pole color as RGB list or symbol"
    },
    {
      "type": "zerocolor <anything>",
      "description": "sets zero color as RGB list or symbol"
    },
    {
      "type": "colors <symbol, symbol, symbol, symbol>",
      "description": "sets background, axis, pole and zero colors as symbols"
    },
    {
      "type": "theme <float>",
      "description": "nonzero uses Pd's theme colors"
    },
    {
      "type": "transparent <float>",
      "description": "nonzero makes the background transparent"
    }
  ],
  "body": "[zbiplot] plots the biquad coefficients as poles and zeros on the Z-Plane."
}