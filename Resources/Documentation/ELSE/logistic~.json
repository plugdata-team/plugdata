{
  "title": [
    "logistic~"
  ],
  "description": "logistic chaotic generator",
  "origin": "ELSE",
  "categories": [
    "Signal Generators"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "list/signals",
          "description": "frequency in Hz (negative values accepted)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "logistic chaotic signal"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "sets frequency in Hz",
      "default": "0"
    },
    {
      "type": "float",
      "description": "sets p",
      "default": "1"
    },
    {
      "type": "float",
      "description": "sets y[n-1]",
      "default": "0.1"
    }
  ],
  "flags": [
    {
      "name": "-mc <list>",
      "description": "sets multichannel output with a list of frequencies"
    }
  ],
  "methods": [
    {
      "type": "coeffs <list>",
      "description": "up to 2 floats set 'p' and y[n-1]"
    },
    {
      "type": "set <float, float>",
      "description": "<channel, freq> set a single frequency channel"
    }
  ],
  "body": "[logistic~] is a chaotic generator based on the difference equation: y[n] = (3 + p) * y[n-1] * (1- y[n-1])."
}