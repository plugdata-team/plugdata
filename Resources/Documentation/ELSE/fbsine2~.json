{
  "title": [
    "fbsine2~"
  ],
  "description": "feedback sine with chaotic phase indexing",
  "origin": "ELSE",
  "categories": [
    "Signal Generators"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "frequency in Hz (negative values accepted)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "feedback sine chaotic signal"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "sets frequency in Hz",
      "default": "Nyquist"
    },
    {
      "type": "float",
      "description": "sets 'im'",
      "default": "1"
    },
    {
      "type": "float",
      "description": "sets 'fb'",
      "default": "0.1"
    },
    {
      "type": "float",
      "description": "sets 'a'",
      "default": "1.1"
    },
    {
      "type": "float",
      "description": "sets 'c'",
      "default": "0.5"
    },
    {
      "type": "float",
      "description": "sets initial value of x[n]",
      "default": "0.1"
    },
    {
      "type": "float",
      "description": "sets initial phase value of y[n]",
      "default": "0.1"
    }
  ],
  "flags": [
    {
      "name": "-mc <list>",
      "description": "sets multichannel output with a list of frequencies"
    }
  ],
  "methods": [
    {
      "type": "coeffs <list>",
      "description": "up to 6 floats set 'im', 'fb', 'a', 'c', 'xn' and 'yn'"
    },
    {
      "type": "set <float, float>",
      "description": "<channel, freq> sets a single frequency channel"
    }
  ],
  "body": "[fbsine2~] is a non-interpolating sound generator based on the difference equations below (for im = 1, fb = 0 and a = 1, a sine wave results);\nx(n+1) = sin(im * y(n) + fb * x(n));\ny(n+1) = (a * y(n) + c) % 2pi"
}
