{
  "title": [
    "osc.send"
  ],
  "description": "send OSC messages",
  "origin": "ELSE",
  "categories": [
    "Networking"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "disconnect",
          "description": "disconnect from network"
        },
        {
          "type": "connect <address, port>",
          "description": "connect to address/port"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "connection status"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "symbol",
      "description": "address (optional)",
      "default": "localhost"
    },
    {
      "type": "float",
      "description": "port (obligatory, no default)",
      "default": ""
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "disconnect",
      "description": "disconnects from network"
    },
    {
      "type": "connect <symbol, float>",
      "description": "connects to address/port (address optional)"
    }
  ],
  "body": "[osc.send] sends OSC messages over the network and is an abstraction based on [osc.format] and [netsend]."
}
