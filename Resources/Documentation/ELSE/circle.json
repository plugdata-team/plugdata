{
  "title": [
    "circle"
  ],
  "description": "circular slider",
  "origin": "ELSE",
  "categories": [
    "UI"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "outputs last values"
        },
        {
          "type": "list",
          "description": "sets x, y and outputs it"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "list",
          "description": "x/y values"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [
    {
      "name": "-size <float>",
      "description": "sets x/y size (default 127)"
    },
    {
      "name": "-range <float, float>",
      "description": "sets x and y range (default -1 1)"
    },
    {
      "name": "-xrange <float, float>",
      "description": "sets x range (default -1 1)"
    },
    {
      "name": "-yrange <float, float>",
      "description": "sets y range (default -1 1)"
    },
    {
      "name": "-mode <float>",
      "description": "0 for none, 1 for crosshair, 2 for line to center (default 1)"
    },
    {
      "name": "-grid <float>",
      "description": "nonzero sets grid visibility (default 1)"
    },
    {
      "name": "-clip <float>",
      "description": "nonzero clips inside the circle (default 1)"
    },
    {
      "name": "-jump <float>",
      "description": "nonzero sets to jump on click mode (default 0)"
    },
    {
      "name": "-savestate <float>",
      "description": "nonzero saves the position with the patch (default 0)"
    },
    {
      "name": "-bgcolor1 <float, float, float>",
      "description": "sets the background square's color in RGB"
    },
    {
      "name": "-bgcolor2 <float, float, float>",
      "description": "sets the circle's color in RGB"
    },
    {
      "name": "-fgcolor <float, float, float>",
      "description": "sets foreground color in RGB"
    },
    {
      "name": "-usetheme <float>",
      "description": "nonzero uses Pd's theme colors instead of the colors set here (default 1)"
    },
    {
      "name": "-transparent <float>",
      "description": "0 for none, 1 for the background, 2 for all; bare means 1 (default 0)"
    },
    {
      "name": "-send <symbol>",
      "description": "sets send symbol (default empty)"
    },
    {
      "name": "-receive <symbol>",
      "description": "sets receive symbol (default empty)"
    }
  ],
  "methods": [
    {
      "type": "set <float, float>",
      "description": "sets x and y without output"
    },
    {
      "type": "size <float>",
      "description": "sets size"
    },
    {
      "type": "range <float, float>",
      "description": "sets x and y range"
    },
    {
      "type": "xrange <float, float>",
      "description": "sets x range"
    },
    {
      "type": "yrange <float, float>",
      "description": "sets y range"
    },
    {
      "type": "mode <float>",
      "description": "0 for none, 1 for crosshair, 2 for line to center"
    },
    {
      "type": "grid <float>",
      "description": "nonzero sets grid visibility"
    },
    {
      "type": "clip <float>",
      "description": "nonzero clips inside the circle"
    },
    {
      "type": "jump <float>",
      "description": "nonzero sets to jump on click mode"
    },
    {
      "type": "savestate <float>",
      "description": "nonzero saves the position with the patch"
    },
    {
      "type": "bgcolor1 <float, float, float>",
      "description": "sets the background square's color in RGB"
    },
    {
      "type": "bgcolor2 <float, float, float>",
      "description": "sets the circle's color in RGB"
    },
    {
      "type": "bgcolor <float, float, float>",
      "description": "sets both background colors in RGB"
    },
    {
      "type": "fgcolor <float, float, float>",
      "description": "sets foreground color in RGB"
    },
    {
      "type": "usetheme <float>",
      "description": "nonzero uses Pd's theme colors instead of the colors set here"
    },
    {
      "type": "transparent <float>",
      "description": "0 for none, 1 for the background, 2 for all"
    },
    {
      "type": "send <symbol>",
      "description": "sets send symbol"
    },
    {
      "type": "receive <symbol>",
      "description": "sets receive symbol"
    }
  ],
  "body": "[circle] is a two dimensional slider GUI abstraction (see also [else/slider2d)."
}