{
  "title": [
    "resonant~"
  ],
  "description": "bandpass resonant filter (constant skirt)",
  "origin": "ELSE",
  "categories": [
    "Filters",
    "Effects"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "signal to be filtered or excite the resonator"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "central frequency in Hz"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "resonance (Q, bw or t60)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "resonator/filtered signal"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "center frequency in Hz",
      "default": "0"
    },
    {
      "type": "float",
      "description": "resonance",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "-bw",
      "description": "sets resonance parameter to bandwidth in octaves"
    },
    {
      "name": "-t60",
      "description": "sets resonance parameter to 't60'"
    }
  ],
  "methods": [
    {
      "type": "freq <list>",
      "description": "cutoff frequency in Hz for each channel"
    },
    {
      "type": "reson <list>",
      "description": "filter resonance for each channel"
    },
    {
      "type": "clear",
      "description": "clears filter's memory"
    },
    {
      "type": "bypass <float>",
      "description": "1 (bypasses input signal) or 0 (doesn't bypass)"
    },
    {
      "type": "q",
      "description": "sets resonance parameter to Q (default)"
    },
    {
      "type": "bw",
      "description": "sets resonance parameter to bandwidth in octaves"
    },
    {
      "type": "t60",
      "description": "sets resonance parameter to decay time in ms"
    }
  ],
  "body": "[resonant~] is a bandpass resonator filter like [bandpass~], but it doesn't have a maximum dB value of 0, so changing the Q increases the gain of the filter. Besides 'Q' and 'bw' you can also set the resonance as 't60' (like with [resonator~])."
}