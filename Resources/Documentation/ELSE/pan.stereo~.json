{
  "title": [
    "pan.stereo~"
  ],
  "description": "stereo panning",
  "origin": "ELSE",
  "categories": [
    "Mixing and Routing"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "left signal input(s)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "right signal input(s)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "pan value from -1 to 1"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "left channel(s)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "signals",
          "description": "right channel(s)"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "initial pan value",
      "default": "0"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "pan <list>",
      "description": "pan value(s) from -1 to 1"
    }
  ],
  "body": "[pan.stereo~] sets the stereo input pan which merges both channels to the left or right. It uses sin/cos equal power panning."
}