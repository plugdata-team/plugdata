{
  "title": [
    "button"
  ],
  "description": "button GUI",
  "origin": "ELSE",
  "categories": [
    "UI"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "outputs a bang in bang mode; outputs the current state without changing it in latch or toggle mode; ignored in click mode"
        },
        {
          "type": "float",
          "description": "when not in bang mode, set state"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "latch status (on=1 or off=0)"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [
    {
      "name": "-bng",
      "description": "sets to bang mode (default latch)"
    },
    {
      "name": "-tgl",
      "description": "sets to toggle mode (default latch)"
    },
    {
      "name": "-oval",
      "description": "sets to oval style"
    },
    {
      "name": "-readonly",
      "description": "sets to readonly mode"
    },
    {
      "name": "-dim <float, float>",
      "description": "x/y dimensions (default 20 20)"
    },
    {
      "name": "-size <float>",
      "description": "sets both horizontal and vertical size in pixels"
    },
    {
      "name": "-send <symbol>",
      "description": "set send name"
    },
    {
      "name": "-receive <symbol>",
      "description": "set receive name"
    },
    {
      "name": "-transparent <float>",
      "description": "set transparency level"
    },
    {
      "name": "-bgcolor <float, float, float>",
      "description": "background color in RGB (default 255 255 255)"
    },
    {
      "name": "-fgcolor <float, float, float>",
      "description": "foreground color in RGB (default 255 255 255)"
    },
    {
      "name": "-click",
      "description": "sets to click mode (default latch)"
    }
  ],
  "methods": [
    {
      "type": "latch",
      "description": "sets to latch mode"
    },
    {
      "type": "tgl",
      "description": "sets to toggle mode"
    },
    {
      "type": "bng",
      "description": "sets to bang mode"
    },
    {
      "type": "click",
      "description": "sets to click mode"
    },
    {
      "type": "toggle",
      "description": "flips the state and outputs it (toggle mode only)"
    },
    {
      "type": "set <float>",
      "description": "sets the state without output (not in bang mode)"
    },
    {
      "type": "dim <float, float>",
      "description": "sets horizontal and vertical size in pixels"
    },
    {
      "type": "send <symbol>",
      "description": "set send symbol"
    },
    {
      "type": "receive <symbol>",
      "description": "set receive symbol"
    },
    {
      "type": "oval <float>",
      "description": "nonzero sets to oval style, 0 hides it"
    },
    {
      "type": "size <float>",
      "description": "sets both horizontal and vertical size in pixels"
    },
    {
      "type": "width <float>",
      "description": "sets horizontal size in pixels"
    },
    {
      "type": "height <float>",
      "description": "sets vertical size in pixels"
    },
    {
      "type": "bgcolor <float, float, float>",
      "description": "sets background color in RGB"
    },
    {
      "type": "fgcolor <float, float, float>",
      "description": "sets foreground color in RGB"
    },
    {
      "type": "transparent <float>",
      "description": "set transparency level"
    },
    {
      "type": "readonly <float>",
      "description": "nonzero sets to 'read only'"
    }
  ],
  "body": "[button] is a GUI button that responds to mouse clicks. When clicked on, it sends a \"1\" value, and outputs \"0\" when releasing the mouse button."
}
