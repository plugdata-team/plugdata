{
  "title": [
    "envgen~"
  ],
  "description": "envelope generator",
  "origin": "ELSE",
  "categories": [
    "Envelopes and LFOs"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "gate: on/attack (nonzero) or off/release (0)"
        },
        {
          "type": "bang",
          "description": "attacks the envelope with the last gate on value"
        },
        {
          "type": "list",
          "description": "duration/target pairs, an odd first value is the start"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "impulses to retrigger the envelope"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "set time multiplier"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "envelope signal"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "status: 1 <on>, 0 <off>"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "list",
      "description": "one float sets the initial output value, more floats set the envelope",
      "default": "0 0"
    }
  ],
  "flags": [
    {
      "name": "-init <float>",
      "description": "default 0"
    },
    {
      "name": "-curve <float/symbol>",
      "description": "sets curve for all segments (default linear)"
    },
    {
      "name": "-retrigger <float>",
      "description": "default 0"
    },
    {
      "name": "-legato",
      "description": "sets to legato mode on, default is off"
    },
    {
      "name": "-suspoint <float>",
      "description": "default 0"
    },
    {
      "name": "-samps",
      "description": "sets time to samples (default ms)"
    },
    {
      "name": "-loop",
      "description": "sets to loop mode"
    },
    {
      "name": "-mul <float>",
      "description": "sets time multiplier (default: 1)"
    },
    {
      "name": "-norm",
      "description": "normalizes gates/trigger to 1"
    }
  ],
  "methods": [
    {
      "type": "norm <float>",
      "description": "nonzero normalizes gates/impulses to 1"
    },
    {
      "type": "setgain <float>",
      "description": "sets overall gain"
    },
    {
      "type": "curve <list>",
      "description": "sets exponential values for each line segment"
    },
    {
      "type": "attack",
      "description": "same as bang or gate on"
    },
    {
      "type": "release",
      "description": "same as a gate off"
    },
    {
      "type": "pause",
      "description": "pauses the output"
    },
    {
      "type": "resume",
      "description": "resumes the envelope after being paused"
    },
    {
      "type": "suspoint <float>",
      "description": "sets sustain point"
    },
    {
      "type": "retrigger <float>",
      "description": "retrigger time in ms"
    },
    {
      "type": "legato <float>",
      "description": "nonzero sets to legato mode"
    },
    {
      "type": "loop <float>",
      "description": "nonzero sets to loop mode"
    },
    {
      "type": "samps <float>",
      "description": "nonzero sets to samples instead of ms"
    }
  ],
  "body": "[envgen~] is an envelope (and an all purpose line) generator (here it creates a 1000 ms line to 1 and 500 ms line to 0)."
}