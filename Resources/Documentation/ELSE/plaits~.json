    {
      "name": "-midi",
      "description": "sets pitch input to MIDI (default Hz)"
    },
    {
      "name": "-model <float>",
      "description": "set model number (default 0)"
    },
    {
      "name": "-tr_active",
      "description": "enables trigger input (default disabled)"
    },
    {
      "name": "-lvl_active",
      "description": "enables level input (default disabled)"
    },
    {
      "name": "-timbre_active",
      "description": "enables timbre modulation input (default disabled)"
    },
    {
      "name": "-freq_active",
      "description": "enables frequency modulation input (default disabled)"
    },
    {
      "name": "-morph_active",
      "description": "enables morph modulation input (default disabled)"
    },
    {
      "name": "-midi_active",
      "description": "force MIDI mode (default disabled)"
    }
  ],
  "methods": [
    {
      "type": "hz",
      "description": "set frequency mode to Hz"
    },
    {
      "type": "midi",
      "description": "set frequency mode to MIDI"
    },
    {
      "type": "cv",
      "description": "set frequency mode to CV"
    },
    {
      "type": "transp <float>",
      "description": "set transposition in MIDI"
    },
    {
      "type": "tr_active <float>",
      "description": "nonzero sets to trigger mode"
    },
    {
      "type": "lvl_active <float>",
      "description": "nonzero enables level input"
    },
    {
      "type": "model <float>",
      "description": "set model number (0-15)"
    },
    {
      "type": "harmonics <float>",
      "description": "set harmonics (0-1)"
    },
    {
      "type": "timbre <float>",
      "description": "set timbre (0-1)"
    },
    {
      "type": "timbre_mod <float>",
      "description": "set timbre modulation attenuverter (-1 to 1)"
    },
    {
      "type": "timbre_active <float>",
      "description": "nonzero activates signal input modulation"
    },
    {
      "type": "morph <float>",
      "description": "set morph (0-1)"
    },
    {
      "type": "morph_mod <float>",
      "description": "set morph modulation attenuverter (-1 to 1)"
    },
    {
      "type": "morph_active <float>",
      "description": "nonzero activates signal input modulation"
    },
    {
      "type": "freq_active <float>",
      "description": "nonzero activates signal input modulation"
    },
    {
      "type": "midi_active <float>",
      "description": "nonzero forces MIDI input over signal"
    },
    {
      "type": "freq_mod <float>",
      "description": "set frequency modulation attenuverter (-1 to 1)"
    },
    {
      "type": "cutoff <float>",
      "description": "set lowpass gate cutoff/color (0-1)"
    },
    {
      "type": "decay <float>",
      "description": "set lowpass gate decay (0-1)"
    },
    {
      "type": "print",
      "description": "output information on terminal window"
    },
    {
      "type": "dump",
      "description": "output information on rightmost outlet"
    }
  ],
  "body": "[plaits~] is based on the \"Plaits\" module from Mutable Instruments."
