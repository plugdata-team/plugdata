{
  "title": [
    "spread"
  ],
  "description": "compare floats and spread them",
  "origin": "ELSE",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float/list",
          "description": "value(s) to spread"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "output to an outlet as the result of the comparison"
        }
      ],
      "repeat": true
    }
  ],
  "arguments": [
    {
      "type": "list",
      "description": "floats to compare to",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "-mode <float>",
      "description": "sets mode, 0 and 1 (in reverse to [moses]) (default 0)"
    }
  ],
  "methods": [
    {
      "type": "args <list>",
      "description": "replace arguments"
    },
    {
      "type": "mode <float>",
      "description": "sets mode"
    }
  ],
  "body": "Similar to [moses], [spread] compares an incoming float to the arguments and spreads to different outputs. One difference to [moses] is that it takes multiple arguments and has an extra mode."
}