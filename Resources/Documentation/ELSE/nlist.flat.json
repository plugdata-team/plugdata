{
  "title": [
    "nlist.flat"
  ],
  "description": "flatten a nested list",
  "origin": "ELSE",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "output flat list"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "symbol",
          "description": "set name of nested list"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "list",
          "description": "nested list as a flat list"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "symbol",
      "description": "nested list name to bind to",
      "default": ""
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "name <symbol>",
      "description": "set name of nested list"
    }
  ],
  "body": "[nlist.flat] outputs the nested list as a flat (one dimensional) list. Clicking on the object opens the editor window of the [nlist.define] object with the same name."
}