{
  "title": [
    "ikeda~"
  ],
  "description": "Ikeda map chaotic generator",
  "origin": "ELSE",
  "categories": [
    "Random and Noise",
    "Signal Generators"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "list/signals",
          "description": "frequency in Hz (negative values accepted)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "Ikeda map chaotic signal (y[n])"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "sets frequency in Hz",
      "default": "Nyquist"
    },
    {
      "type": "float",
      "description": "sets initial \"u\" parameter",
      "default": "0.75"
    },
    {
      "type": "float",
      "description": "sets initial value of y1[n-1]",
      "default": "0"
    },
    {
      "type": "float",
      "description": "sets initial value of y2[n-1]",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "-mc <list>",
      "description": "sets multichannel output with a list of frequencies"
    }
  ],
  "methods": [
    {
      "type": "list",
      "description": "2 floats set y1[n-1] and y2[n-1], respectively"
    },
    {
      "type": "coeffs <list>",
      "description": "up to 3 floats set 'u', y[n-1] and y[n-2]"
    },
    {
      "type": "set <float, float>",
      "description": "<channel, freq> set a single frequency channel"
    }
  ],
  "body": "[ikeda~] is an ikeda map chaotic generator with two audio outputs, generated by the difference equations;\ny1[n] = 1 + u * (y1[n-1] * cos(t) - y2[n-1] * sin(t));\ny2[n] = u * (y1[n-1] * sin(t) + y2[n-1] * cos(t));\nwhere t = 0.4 - 6 / (1 + y1[n-1]^2 + y2[n-1]^2)"
}