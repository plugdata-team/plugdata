{
  "title": [
    "randpulse"
  ],
  "description": "random pulses",
  "origin": "ELSE",
  "categories": [
    "Random and Noise",
    "Signal Generators"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "frequency in Hz"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "pulse width (0-1)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "phase sync (resets internal phase)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "random pulse values"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "frequency in Hz",
      "default": "0"
    },
    {
      "type": "float",
      "description": "initial pulse width",
      "default": "0.5"
    },
    {
      "type": "float",
      "description": "initial phase",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "-rate <float>",
      "description": "sets refresh rate in ms (default 1)"
    },
    {
      "name": "-seed <float>",
      "description": "sets seed (default unique internal)"
    }
  ],
  "methods": [
    {
      "type": "rate <float>",
      "description": "sets refresh rate in ms"
    },
    {
      "type": "seed <float>",
      "description": "a float sets seed, no float sets a unique internal"
    }
  ],
  "body": "[randpulse] is a control rate random pulse oscillator: it alternates between a random value and 0, with a default resolution of 1 ms. It accepts negative frequencies and has inlets for pulse width and phase sync."
}