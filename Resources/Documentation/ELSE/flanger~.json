    {
      "messages": [
        {
          "type": "float",
          "description": "rate in Hz"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "depth (ms)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "coefficient for feedforward/feedback lines"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "flanger output"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "rate in Hz",
      "default": "0"
    },
    {
      "type": "float",
      "description": "depth in ms",
      "default": "0"
    },
    {
      "type": "float",
      "description": "coefficient",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "-tri",
