    },
    {
      "name": "-delay <float>",
      "description": "set minimum delay (default 1)"
    }
  ],
  "methods": [
    {
      "type": "width <float>",
      "description": "set delay width/amplitude"
    },
    {
      "type": "delay <float>",
      "description": "set minimum delay"
    },
    {
      "type": "tri <float>",
      "description": "nonzero sets triangular waveform"
    }
  ],
  "body": "[flanger~] is a simple flanger FX object."
