{
  "title": [
    "impulse~",
    "imp~"
  ],
  "description": "impulse oscillator signal",
  "origin": "ELSE",
  "categories": [
    "Signal Generators"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "list/signals",
          "description": "frequency in Hz or MIDI"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "phase sync (resets internal phase)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "phase offset (modulation input)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "impulse oscillator signal"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "frequency in Hz",
      "default": "0"
    },
    {
      "type": "float",
      "description": "initial phase offset",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "-mc <list>",
      "description": "sets multichannel output with a list of frequencies"
    },
    {
      "name": "-midi",
      "description": "sets frequency input in MIDI pitch (default Hz)"
    },
    {
      "name": "-soft",
      "description": "sets to soft sync mode (default hard)"
    }
  ],
  "methods": [
    {
      "type": "midi <float>",
      "description": "nonzero sets to frequency input in MIDI pitch"
    },
    {
      "type": "set <float, float>",
      "description": "<channel, freq> set a single frequency channel"
    },
    {
      "type": "soft <float>",
      "description": "nonzero sets to soft sync mode"
    }
  ],
  "body": "The [impulse~] object (or [imp~] for short) is an impulse oscillator that accepts negative frequencies, has inlets for phase sync and phase modulation."
}