{
  "title": [
    "grain.sampler~"
  ],
  "description": "granular sampler",
  "origin": "ELSE",
  "categories": [
    "Effects",
    "Buffers"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "plays an event of pitch clouds"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "number of grains in cloud event (minimum 1, maximum 256)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "left channel output"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "signal",
          "description": "right channel output"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [
    {
      "name": "-n <float>",
      "description": ""
    },
    {
      "name": "-t <symbol>",
      "description": "table name"
    },
    {
      "name": "-dur <float>",
      "description": ""
    },
    {
      "name": "-size <float, float>",
      "description": ""
    },
    {
      "name": "-transp <float, float>",
      "description": ""
    },
    {
      "name": "-pan <float, float>",
      "description": ""
    },
    {
      "name": "-sync",
      "description": ""
    },
    {
      "name": "-env <anything>",
      "description": ""
    },
    {
      "name": "-amps <float, float>",
      "description": ""
    },
    {
      "name": "-pos <float, float>",
      "description": ""
    },
    {
      "name": "-autotune <float>",
      "description": ""
    },
    {
      "name": "-scale <list>",
      "description": ""
    },
    {
      "name": "-rev <float>",
      "description": ""
    }
  ],
  "methods": [
    {
      "type": "n <float>",
      "description": "number of grains in cloud event (minimum 1, maximum 256)"
    },
    {
      "type": "sync <float>",
      "description": "nonzero sets to synchronous mode (default 0)"
    },
    {
      "type": "dur <float>",
      "description": "sets cloud event duration in ms (default 500)"
    },
    {
      "type": "set <symbol>",
      "description": "sets table name with loaded sample"
    },
    {
      "type": "sr <float>",
      "description": "sets sample rate for reading the buffer (default Pd's)"
    },
    {
      "type": "size <float, float>",
      "description": "sets min/max grain sizes in ms (default 50 to 450)"
    },
    {
      "type": "transp <float, float>",
      "description": "sets min/max transposition in cents (default -1200 to 1200)"
    },
    {
      "type": "pos <float, float>",
      "description": "sets min/max grain position (default 0 to 1)"
    },
    {
      "type": "pan <float, float>",
      "description": "sets left and right pan boundaries (default -1 to 1)"
    },
    {
      "type": "amp <float, float>",
      "description": "min/max amplitude values (default 0.1 to 1)"
    },
    {
      "type": "rev <float>",
      "description": "sets probability in % of grain being reversed (default 0)"
    },
    {
      "type": "env <anything>",
      "description": "envelope type (sin, hann, tri, gauss) or function list"
    },
    {
      "type": "autotune <float>",
      "description": "nonzero autotunes to a given scale (default 0)"
    },
    {
      "type": "scale <list>",
      "description": "scale to autotune to in cents (default equal temperament)"
    }
  ],
  "body": "[grain.sampler~] is a sample based granulator that generates clouds of grains."
}