{
  "title": [
    "bicoeff2"
  ],
  "description": "biquad coefficient generator",
  "origin": "ELSE",
  "categories": [
    "Filters",
    "Data Math"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "sets cutoff/center frequency"
        },
        {
          "type": "bang",
          "description": "generates coefficients"
        },
        {
          "type": "list",
          "description": "frequency, Q/slope and gain, then outputs the coefficients"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "sets \"Q\" or \"Slope\" and outputs coefficients"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "sets gain in dB"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "list",
          "description": "5 coefficients for the vanilla [biquad~] object"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "symbol",
      "description": "(optional) sets type <highpass/etc>,",
      "default": "'off'"
    },
    {
      "type": "float",
      "description": "sets cutoff/center frequency",
      "default": "0"
    },
    {
      "type": "float",
      "description": "sets Q/slope",
      "default": "1"
    },
    {
      "type": "float",
      "description": "sets gain in dB",
      "default": "0"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "allpass <list>",
      "description": "sets an allpass filter, optionally with frequency, Q/slope and gain"
    },
    {
      "type": "lowpass <list>",
      "description": "sets a lowpass filter, optionally with frequency, Q/slope and gain"
    },
    {
      "type": "highpass <list>",
      "description": "sets a highpass filter, optionally with frequency, Q/slope and gain"
    },
    {
      "type": "bandpass <list>",
      "description": "sets a bandpass filter, optionally with frequency, Q/slope and gain"
    },
    {
      "type": "resonant <list>",
      "description": "sets a resonant filter, optionally with frequency, Q/slope and gain"
    },
    {
      "type": "bandstop <list>",
      "description": "sets a bandstop filter, optionally with frequency, Q/slope and gain"
    },
    {
      "type": "eq <list>",
      "description": "sets an eq filter, optionally with frequency, Q/slope and gain"
    },
    {
      "type": "lowshelf <list>",
      "description": "sets a lowshelf filter, optionally with frequency, Q/slope and gain"
    },
    {
      "type": "highshelf <list>",
      "description": "sets a highshelf filter, optionally with frequency, Q/slope and gain"
    },
    {
      "type": "qs <float>",
      "description": "sets \"Q\" or \"Slope\" and outputs coefficients"
    },
    {
      "type": "gain <float>",
      "description": "sets gain in dB and outputs coefficients"
    }
  ],
  "body": "[bicoeff2] generates coefficients for vanilla's [biquad~] according to different filter types. All inlets are hot!"
}