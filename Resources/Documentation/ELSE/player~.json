{
  "title": [
    "player~"
  ],
  "description": "multi-channel player",
  "origin": "ELSE",
  "categories": [
    "Buffers"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "nonzero plays, <0> stops"
        },
        {
          "type": "bang",
          "description": "play (same as nonzero)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "the buffer signal of channel $nth"
        }
      ],
      "repeat": true
    },
    {
      "messages": [
        {
          "type": "bang",
          "description": "a bang when finishing playing the buffer"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "(optional) number of channels (max 64)",
      "default": "1 if no file is given, or sound file's if given"
    },
    {
      "type": "symbol",
      "description": "the name of the file to open",
      "default": "none"
    },
    {
      "type": "float",
      "description": "autostart <1: on, 0: off>",
      "default": "0"
    },
    {
      "type": "float",
      "description": "loop <1: on, 0: off>",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "-speed <float>",
      "description": "default 100"
    },
    {
      "name": "-range <float, float>",
      "description": "default 0 1"
    },
    {
      "name": "-fade <float>",
      "description": "default 0"
    },
    {
      "name": "-xfade",
      "description": "xfade mode on"
    },
    {
      "name": "-loop",
      "description": "loop mode on"
    }
  ],
  "methods": [
    {
      "type": "open <symbol>",
      "description": "opens a file (no symbol opens dialog box)"
    },
    {
      "type": "set <symbol>",
      "description": "sets a file to open (needs a reload message)"
    },
    {
      "type": "show",
      "description": "shows the buffer subpatch window"
    },
    {
      "type": "hide",
      "description": "hides the buffer subpatch window"
    },
    {
      "type": "start <float>",
      "description": "sets start point in ms"
    },
    {
      "type": "end <float>",
      "description": "sets end point in ms"
    },
    {
      "type": "range <float, float>",
      "description": "sets start and end point proportionally (from 0 to 1)"
    },
    {
      "type": "speed <float>",
      "description": "sets playing speed in %"
    },
    {
      "type": "pos <float>",
      "description": "sets position (from 0 to 1) and starts playing it"
    },
    {
      "type": "play <float, float, float>",
      "description": "if no float is given, plays whole file. 1st float sets start, 2nd sets end (in ms) and 3rd sets speed rate"
    },
    {
      "type": "stop",
      "description": "stop playing (can't be resumed)"
    },
    {
      "type": "pause",
      "description": "pause playing (can be resumed)"
    },
    {
      "type": "resume",
      "description": "resume playing after a pause"
    },
    {
      "type": "fade <float>",
      "description": "sets fading time in ms (default 0)"
    },
    {
      "type": "xfade <float>",
      "description": "nonzero sets to crossfading mode (default 0)"
    },
    {
      "type": "loop <float>",
      "description": "nonzero enables looping, <0> disables it (default 0)"
    }
  ],
  "body": "[player~] is a convenient abstraction based on [soundfiler] and [tabplayer~]. It's much more versatile than [play.file~]. For instance, you can play in different speeds and backwards."
}