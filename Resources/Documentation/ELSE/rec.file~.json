{
  "title": [
    "rec.file~"
  ],
  "description": "record sound file",
  "origin": "ELSE",
  "categories": [
    "Buffers"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "first channel to record"
        },
        {
          "type": "start",
          "description": "start recording"
        },
        {
          "type": "stop",
          "description": "stop recording"
        },
        {
          "type": "float",
          "description": "nonzero starts recording, 0 stops"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "next channel to record"
        }
      ],
      "repeat": true
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "outputs a bang when stops recording"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "symbol",
      "description": "(optional) name of the file to save to",
      "default": "file.wav"
    },
    {
      "type": "float",
      "description": "number of channels to record",
      "default": "1"
    }
  ],
  "flags": [
    {
      "name": "-fade <float>",
      "description": "sets fade time (default 10)"
    },
    {
      "name": "-maxtime <float>",
      "description": "sets maximum recording time in ms (default 0)"
    }
  ],
  "methods": [
    {
      "type": "set <symbol>",
      "description": "sets file name (no symbol opens dialog box)"
    },
    {
      "type": "rate <float>",
      "description": "sets the file's sample rate (default Pd's)"
    },
    {
      "type": "fade <float>",
      "description": "sets fade time (minimum 1)"
    },
    {
      "type": "maxtime <float>",
      "description": "sets maximum recording time in ms"
    }
  ],
  "body": "[rec.file~] is a convenient abstraction based on [writesf~], so it records sample files that you can load with other objects, such as [sample~], [play.file~], [player~] and others."
}