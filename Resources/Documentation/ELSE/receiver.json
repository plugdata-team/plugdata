{
  "title": [
    "receiver"
  ],
  "description": "receive messages",
  "origin": "ELSE",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "anything",
          "description": "messages are passed through to the left outlet (like the bound receive names)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "symbol/list",
          "description": "set receive names"
        },
        {
          "type": "bang",
          "description": "spits receive names"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "anything",
          "description": "any received messages (or receive names at bangs)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "symbol",
          "description": "learnt send symbol"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "optional depth value",
      "default": "1"
    },
    {
      "type": "list",
      "description": "up to two receive names",
      "default": ""
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "clear",
      "description": "clears the receive names (right inlet)"
    },
    {
      "type": "learn",
      "description": "activate 'learn' (right inlet)"
    },
    {
      "type": "deactivate",
      "description": "deactivate 'learn' (right inlet)"
    },
    {
      "type": "forget",
      "description": "forget and clear the learnt symbol (right inlet)"
    }
  ],
  "body": "[receiver] is like vanilla's [receive]. It can have up to two names, has an inlet to set the receive names and at load time can expand dollar symbols according to parent patches."
}
