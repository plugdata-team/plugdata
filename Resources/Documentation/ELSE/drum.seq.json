{
  "title": [
    "drum.seq"
  ],
  "description": "drum sequence pattern GUI",
  "origin": "ELSE",
  "categories": [
    "Triggers and Clocks"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "gets sequence value and moves to the next"
        },
        {
          "type": "list",
          "description": "sets track, slot and status (no output)"
        },
        {
          "type": "float",
          "description": "sets slot value and output tracks values"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "list",
          "description": "track and slot value (indexed from 1)"
        },
        {
          "type": "bang",
          "description": "when reaching the end of the sequence"
        },
        {
          "type": "export <list>",
          "description": "the sequence contents, after an 'export' message"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "bang",
          "description": "when reaching the end of the sequence"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [
    {
      "name": "-tracks <float>",
      "description": "sets number of tracks (default 2)"
    },
    {
      "name": "-slots <float>",
      "description": "sets number of slots (default 8)"
    },
    {
      "name": "-size <float>",
      "description": "sets cell size in pixels (default 20)"
    },
    {
      "name": "-embed",
      "description": "sets embedding mode (default no embedding)"
    },
    {
      "name": "-bgcolor <float, float, float>",
      "description": "sets background color in RGB"
    },
    {
      "name": "-activecolor <float, float, float>",
      "description": "sets active cell color in RGB"
    },
    {
      "name": "-gridcolor <float, float, float>",
      "description": "sets grid line color in RGB"
    },
    {
      "name": "-flashcolor <float, float, float>",
      "description": "sets the color the current column flashes in, in RGB"
    },
    {
      "name": "-usetheme <float>",
      "description": "nonzero uses Pd's theme colors instead of the colors set here (default 1)"
    },
    {
      "name": "-transparent",
      "description": "makes the background transparent"
    }
  ],
  "methods": [
    {
      "type": "track <list>",
      "description": "sets track values (1st value sets track number)"
    },
    {
      "type": "goto <float>",
      "description": "sets slot value"
    },
    {
      "type": "clear",
      "description": "clears active cells (no output)"
    },
    {
      "type": "bgcolor <float, float, float>",
      "description": "sets background color in RGB"
    },
    {
      "type": "activecolor <float, float, float>",
      "description": "sets active cell color in RGB"
    },
    {
      "type": "gridcolor <float, float, float>",
      "description": "sets grid line color in RGB"
    },
    {
      "type": "flashcolor <float, float, float>",
      "description": "sets the color the current column flashes in, in RGB"
    },
    {
      "type": "usetheme <float>",
      "description": "nonzero uses Pd's theme colors instead of the colors set here"
    },
    {
      "type": "transparent <float>",
      "description": "nonzero makes the background transparent"
    },
    {
      "type": "export <float>",
      "description": "export tracks, no float exports all as an array"
    },
    {
      "type": "import <list>",
      "description": "import contents as an array"
    },
    {
      "type": "tracks <float>",
      "description": "sets number of tracks (clears data)"
    },
    {
      "type": "slots <float>",
      "description": "sets number of slots (clears data)"
    },
    {
      "type": "size <float>",
      "description": "sets cell size in pixels (clears data)"
    },
    {
      "type": "embed <float>",
      "description": "nonzero save internal contents with the object"
    }
  ],
  "body": "[drum.seq] provides a drum grid so you can activate cells to represent attacks."
}