{
  "title": [
    "scope~"
  ],
  "description": "oscilloscope display",
  "origin": "ELSE",
  "categories": [
    "UI",
    "Analysis"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "signal to be displayed in the X axis"
        },
        {
          "type": "list",
          "description": "one float sets 'nsamples', optional second sets 'nlines'"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "signal to be displayed on the Y axis"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [
    {
      "name": "-nsamples <float>",
      "description": "sets number of samples per line (2-8192, default 256)"
    },
    {
      "name": "-nlines <float>",
      "description": "sets number of lines in buffer (8-256, default 128)"
    },
    {
      "name": "-dim <float, float>",
      "description": "sets width/height (default 200 100)"
    },
    {
      "name": "-range <float, float>",
      "description": "sets vertical range (default -1 1)"
    },
    {
      "name": "-fgcolor <float, float, float>",
      "description": "sets front/signal RGB color"
    },
    {
      "name": "-bgcolor <float, float, float>",
      "description": "sets background RGB color"
    },
    {
      "name": "-gridcolor <float, float, float>",
      "description": "sets grid RGB color"
    },
    {
      "name": "-trigger <float>",
      "description": "sets trigger mode: 0 for none, 1 for up or 2 for down (default 0)"
    },
    {
      "name": "-triglevel <float>",
      "description": "sets threshold level for the trigger mode (default 0)"
    },
    {
      "name": "-delay <float>",
      "description": "sets onset time delay between displays (default 0)"
    },
    {
      "name": "-receive <symbol>",
      "description": "sets receive symbol (default empty)"
    }
  ],
  "methods": [
    {
      "type": "nsamples <float>",
      "description": "sets number of samples per line (2-8192, default 256)"
    },
    {
      "type": "nlines <float>",
      "description": "sets number of lines in buffer (8-256, default 128)"
    },
    {
      "type": "dim <float, float>",
      "description": "sets width/height (default 200 100)"
    },
    {
      "type": "range <float, float>",
      "description": "sets vertical range (default -1 1)"
    },
    {
      "type": "fgcolor <float, float, float>",
      "description": "sets front/signal RGB color (values 0-255)"
    },
    {
      "type": "bgcolor <float, float, float>",
      "description": "sets background RGB color (values 0-255)"
    },
    {
      "type": "gridcolor <float, float, float>",
      "description": "sets grid RGB color (values 0-255)"
    },
    {
      "type": "trigger <float>",
      "description": "sets trigger mode: 0 for none (default), 1 for up or 2 for down"
    },
    {
      "type": "triglevel <float>",
      "description": "sets threshold level for the trigger mode (default 0)"
    },
    {
      "type": "delay <float>",
      "description": "onset time delay between displays (default 0)"
    },
    {
      "type": "receive <symbol>",
      "description": "receive symbol (default empty)"
    }
  ],
  "body": "[scope~] displays a signal in the style of an oscilloscope."
}