{
  "title": [
    "slider2d"
  ],
  "description": "two-dimensional slider",
  "origin": "ELSE",
  "categories": [
    "UI"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "outputs last values"
        },
        {
          "type": "list",
          "description": "sets x and y and outputs them"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "list",
          "description": "x/y values"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [
    {
      "name": "-size <float>",
      "description": "sets x/y size (default 127)"
    },
    {
      "name": "-dim <float, float>",
      "description": "sets x/y sizes independently (default 127 127)"
    },
    {
      "name": "-width <float>",
      "description": "sets x size (default 127)"
    },
    {
      "name": "-height <float>",
      "description": "sets y size (default 127)"
    },
    {
      "name": "-range <float, float>",
      "description": "sets x/y range (default 0 127)"
    },
    {
      "name": "-xrange <float, float>",
      "description": "sets x range (default 0 127)"
    },
    {
      "name": "-yrange <float, float>",
      "description": "sets y range (default 0 127)"
    },
    {
      "name": "-line <float>",
      "description": "nonzero sets line visibility (default 1)"
    },
    {
      "name": "-grid <float>",
      "description": "nonzero sets grid visibility (default 0)"
    },
    {
      "name": "-bgcolor <float, float, float>",
      "description": "sets background color in RGB"
    },
    {
      "name": "-fgcolor <float, float, float>",
      "description": "sets foreground color in RGB"
    },
    {
      "name": "-savestate <float>",
      "description": "nonzero sets to save state mode (default 0)"
    },
    {
      "name": "-jump <float>",
      "description": "nonzero sets to jump on click mode (default 0)"
    },
    {
      "name": "-send <symbol>",
      "description": "sets send symbol (default empty)"
    },
    {
      "name": "-receive <symbol>",
      "description": "sets receive symbol (default empty)"
    },
    {
      "name": "-usetheme <float>",
      "description": "nonzero uses Pd's theme colors instead of the colors set here (default 1)"
    },
    {
      "name": "-transparent",
      "description": "makes the background transparent"
    }
  ],
  "methods": [
    {
      "type": "set <float, float>",
      "description": "sets x and y"
    },
    {
      "type": "dim <float, float>",
      "description": "sets x and y size together"
    },
    {
      "type": "size <float>",
      "description": "sets size"
    },
    {
      "type": "width <float>",
      "description": "sets x (horizontal) size"
    },
    {
      "type": "height <float>",
      "description": "sets y (vertical) size"
    },
    {
      "type": "range <float, float>",
      "description": "sets range, minimum and maximum of x and y"
    },
    {
      "type": "xrange <float, float>",
      "description": "sets x range"
    },
    {
      "type": "yrange <float, float>",
      "description": "sets y range"
    },
    {
      "type": "line <float>",
      "description": "nonzero sets line visibility"
    },
    {
      "type": "grid <float>",
      "description": "nonzero sets grid visibility"
    },
    {
      "type": "bgcolor <float, float, float>",
      "description": "sets background color in RGB"
    },
    {
      "type": "fgcolor <float, float, float>",
      "description": "sets foreground color in RGB"
    },
    {
      "type": "savestate <float>",
      "description": "nonzero sets to save state mode"
    },
    {
      "type": "jump <float>",
      "description": "nonzero sets to jump on click mode"
    },
    {
      "type": "send <symbol>",
      "description": "sets send symbol"
    },
    {
      "type": "receive <symbol>",
      "description": "sets receive symbol"
    },
    {
      "type": "usetheme <float>",
      "description": "nonzero uses Pd's theme colors instead of the colors set here"
    },
    {
      "type": "transparent <float>",
      "description": "nonzero makes the background transparent"
    }
  ],
  "body": "[slider2d] is a two-dimensional slider GUI (see also [circle])."
}