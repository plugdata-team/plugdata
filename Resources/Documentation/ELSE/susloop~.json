{
  "title": [
    "susloop~"
  ],
  "description": "sustain looper for samplers",
  "origin": "ELSE",
  "categories": [
    "Buffers"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "0 to nonzero: starts and loops. Nonzero to 0: loop is off"
        },
        {
          "type": "bang",
          "description": "trigger: starts from 0 and loops"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "sets increment value (rate/speed)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "the control signal for the sampler"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "status (on: 1 / off: 0)"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "increment value",
      "default": "1"
    },
    {
      "type": "float",
      "description": "loop start",
      "default": "0"
    },
    {
      "type": "float",
      "description": "loop end",
      "default": "2^32 - 1"
    },
    {
      "type": "float",
      "description": "sample size",
      "default": "2^32 - 1"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "release",
      "description": "loop is off"
    },
    {
      "type": "stop",
      "description": "stops and goes back to 0, expects a trigger to restart"
    },
    {
      "type": "pause",
      "description": "pauses/stops incrementing"
    },
    {
      "type": "continue",
      "description": "continues after being paused"
    },
    {
      "type": "loop <float, float>",
      "description": "sets sustain loop range in samples <start, end>"
    },
    {
      "type": "size <float>",
      "description": "sets sample size"
    }
  ],
  "body": "[susloop~] generates a control signal designed to read buffers and loop at a given section. It responds to a gate input (float or signal)."
}