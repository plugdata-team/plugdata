{
  "title": [
    "numbox~"
  ],
  "description": "signal number box",
  "origin": "ELSE",
  "categories": [
    "UI"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "sets generating value"
        },
        {
          "type": "signal",
          "description": "value to display"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "input when monitoring or generated values instead"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [
    {
      "name": "-size <float>",
      "description": "font size (minimum 8) (default patch's)"
    },
    {
      "name": "-load <float>",
      "description": "sets initialization and generating value with given float or sets current value if no float is given"
    },
    {
      "name": "-width <float>",
      "description": "sets digit width (minimum 1) (default 6)"
    },
    {
      "name": "-range <float, float>",
      "description": "dragging range (default 0, 0 - unlimited)"
    },
    {
      "name": "-bgcolor <float, float, float>",
      "description": "sets background color in RGB (default 255 255 255)"
    },
    {
      "name": "-fgcolor <float, float, float>",
      "description": "sets frontground color in RGB (default 0 0 0)"
    },
    {
      "name": "-ramp <float>",
      "description": "sets ramp time in ms (minimum 0) (default 10)"
    },
    {
      "name": "-rate <float>",
      "description": "sets refresh rate in ms (minimum 15) (default 100)"
    }
  ],
  "methods": [
    {
      "type": "size <float>",
      "description": "sets font size"
    },
    {
      "type": "width <float>",
      "description": "sets digits width"
    },
    {
      "type": "range <float, float>",
      "description": "sets minimum and maximum dragging values"
    },
    {
      "type": "bgcolor <float, float, float>",
      "description": "sets background color in RGB"
    },
    {
      "type": "fgcolor <float, float, float>",
      "description": "sets foreground color in RGB"
    },
    {
      "type": "ramp <float>",
      "description": "sets ramp time in ms"
    },
    {
      "type": "rate <float>",
      "description": "sets refresh rate in ms"
    },
    {
      "type": "load <float>",
      "description": "sets initial generating value (default 0)"
    }
  ],
  "body": "[numbox~] is a signal GUI number box. It can be used to display/monitor signal values at a fixed rate or generate them with a ramp time."
}