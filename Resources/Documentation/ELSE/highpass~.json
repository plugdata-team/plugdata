{
  "title": [
    "highpass~"
  ],
  "description": "highpass resonant filter",
  "origin": "ELSE",
  "categories": [
    "Filters"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "signal to be filtered"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "central frequency in Hz"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "filter resonance (Q or bandwidth)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "filtered signal"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "central frequency in Hz",
      "default": "0"
    },
    {
      "type": "float",
      "description": "resonance, either in 'Q' or 'bw'",
      "default": "1 - in Q"
    }
  ],
  "flags": [
    {
      "name": "-bw",
      "description": "sets resonance parameter to bandwidth in octaves"
    },
    {
      "name": "-t60",
      "description": "sets resonance parameter to 't60'"
    }
  ],
  "methods": [
    {
      "type": "clear",
      "description": "clears filter's memory if you blow it up"
    },
    {
      "type": "bypass <float>",
      "description": "1 (bypasses input signal) or 0 (doesn't bypass)"
    },
    {
      "type": "bw",
      "description": "sets resonance parameter to bandwidth in octaves"
    },
    {
      "type": "q",
      "description": "sets resonance parameter to Q (default)"
    },
    {
      "type": "freq <list>",
      "description": "cutoff frequency in Hertz for each channel"
    },
    {
      "type": "reson <list>",
      "description": "filter resonance for each channel"
    },
    {
      "type": "t60",
      "description": "sets resonance parameter to 't60'"
    }
  ],
  "body": "[highpass~] is a 2nd order highpass resonant filter."
}
