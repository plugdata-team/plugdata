{
  "title": [
    "gendyn~"
  ],
  "description": "dynamic stochastic synthesis",
  "origin": "ELSE",
  "categories": [
    "Signal Generators"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "list/signals",
          "description": "center frequency input(s) in Hz (default 440)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "dynamic stochastic synthesis output"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [
    {
      "name": "-n <float>",
      "description": "sets number of points (default 12)"
    },
    {
      "name": "-bw <float>",
      "description": "sets bandwidth in cents or Hz (default 1200 cents)"
    },
    {
      "name": "-cents <float>",
      "description": "nonzero sets bandwidth in cents instead of Hz (default 1)"
    },
    {
      "name": "-frange <float, float>",
      "description": "sets minimum and maximum frequencies (default 220 440)"
    },
    {
      "name": "-freq_step <float>",
      "description": "sets maximum frequency step in % (default 50)"
    },
    {
      "name": "-amp_step <float>",
      "description": "sets maximum amplitude step in % (default 25)"
    },
    {
      "name": "-interp <float>",
      "description": "sets interpolation mode (default 1, linear)"
    },
    {
      "name": "-seed <float>",
      "description": "sets seed (default unique internal)"
    },
    {
      "name": "-dist <float, float, float, float>",
      "description": "sets distributions and their parameters"
    },
    {
      "name": "-mc <list>",
      "description": "sets multichannel output with a list of center frequencies"
    }
  ],
  "methods": [
    {
      "type": "n <float>",
      "description": "set number of points (default 12)"
    },
    {
      "type": "set <float, float>",
      "description": "<channel, freq> set a single center frequency channel"
    },
    {
      "type": "bw <float>",
      "description": "set bandwidth in cents or Hz (default 1200 cents)"
    },
    {
      "type": "cents <float>",
      "description": "nonzero (default) sets bandwidth in cents instead of Hz"
    },
    {
      "type": "frange <float, float>",
      "description": "set minimum and maximum frequencies (default 220, 440)"
    },
    {
      "type": "freq_step <float>",
      "description": "set maximum frequency step in % (default 50)"
    },
    {
      "type": "amp_step <float>",
      "description": "set maximum amplitude step in % (default 25)"
    },
    {
      "type": "interp <float>",
      "description": "sets interpolation mode (default 1, linear)"
    },
    {
      "type": "seed <float>",
      "description": "sets seed, no float sets unique internal (default)"
    },
    {
      "type": "dist <float, float, float, float>",
      "description": "sets distributions and their parameters"
    }
  ],
  "body": "[gendyn~] implements \"Dynamic Stochastic Synthesis\" based on Xenakis' 'GenDyn' algorithm. The waveform has a given number of points (linearly interpolated by default). The period of each point and its value changes according to a random walk (a.k.a. Brownian motion) with given distributions."
}