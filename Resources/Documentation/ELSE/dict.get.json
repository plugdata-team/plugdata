{
  "title": [
    "dict.get"
  ],
  "description": "get the value from a key",
  "origin": "ELSE",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "symbol",
          "description": "key symbol to query"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "symbol",
          "description": "set dictionary name"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "float/symbol/list",
          "description": "the key's value"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "value type: 0 (float), 1 (symbol), 2 (list) or 3 (dictionary)"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "symbol",
      "description": "dictionary name to bind to",
      "default": ""
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "name <symbol>",
      "description": "set dictionary name"
    }
  ],
  "body": "[dict.get] outputs the value of a key in a dictionary, and reports its type on the right outlet. If the key is not present, a warning is given."
}