{
  "title": [
    "lop2~"
  ],
  "description": "1st order lowpass filter",
  "origin": "ELSE",
  "categories": [
    "Filters"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "signal to be filtered"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "cutoff frequency"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "filtered signal"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "cutoff frequency",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "-coeff",
      "description": "sets right input to filter coefficient (default hz)"
    }
  ],
  "methods": [
    {
      "type": "coeff <float>",
      "description": "nonzero sets to coefficient input mode"
    },
    {
      "type": "clear",
      "description": "clear the filter state"
    }
  ],
  "body": "[lop2~] is a 1st order lowpass filter (1-pole, 1-zero)."
}