{
  "title": [
    "width~"
  ],
  "description": "stereo widening",
  "origin": "ELSE",
  "categories": [
    "Mixing and Routing"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "left signal input(s)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "right signal input(s)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "width value from -1 to 1"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "left channel(s)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "signals",
          "description": "right channel(s)"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "initial width value",
      "default": "1"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "width <list>",
      "description": "width value(s) from -1 to 1"
    }
  ],
  "body": "[width~] sets the stereo width, At '1' the output is the same as the input. At '0', both outputs become the same ('mono'). At -1 the channels are swapped."
}