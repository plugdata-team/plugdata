{
  "title": [
    "zl.lace"
  ],
  "description": "interleave two lists",
  "origin": "cyclone",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "performs the operation again on the last received list"
        },
        {
          "type": "anything",
          "description": "list to interleave"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "anything",
          "description": "list to interleave with"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "anything",
          "description": "the interleaved list"
        }
      ],
      "repeat": false
    },
    {
      "messages": [],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "list",
      "description": "initial list to interleave with",
      "default": ""
    }
  ],
  "flags": [
    {
      "name": "@zlmaxsize <float>",
      "description": "maximum list size, 1 to 32767 (default 256)"
    }
  ],
  "methods": [
    {
      "type": "mode <symbol>",
      "description": "changes the mode, as in [zl]"
    },
    {
      "type": "zlclear",
      "description": "clears the mode's arguments and the data received in both inlets"
    },
    {
      "type": "zlmaxsize <float>",
      "description": "sets the maximum list size, 1 to 32767"
    }
  ],
  "body": "[zl.lace] interleaves the list in its left inlet with the one in its right inlet (or the arguments): 'A B C' and '1 2 3' give 'A 1 B 2 C 3'."
}