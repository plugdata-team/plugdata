{
  "title": [
    "zl.sort"
  ],
  "description": "sort a list",
  "origin": "cyclone",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "performs the operation again on the last received list"
        },
        {
          "type": "anything",
          "description": "list to sort"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "order: -1 for descending, ascending otherwise"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "anything",
          "description": "the sorted list"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "list",
          "description": "the original indexes, in sorted order"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "order: -1 for descending, ascending otherwise",
      "default": "0"
    }
  ],
  "flags": [
    {
      "name": "@zlmaxsize <float>",
      "description": "maximum list size, 1 to 32767 (default 256)"
    }
  ],
  "methods": [
    {
      "type": "mode <symbol>",
      "description": "changes the mode, as in [zl]"
    },
    {
      "type": "zlclear",
      "description": "clears the mode's arguments and the data received in both inlets"
    },
    {
      "type": "zlmaxsize <float>",
      "description": "sets the maximum list size, 1 to 32767"
    }
  ],
  "body": "[zl.sort] sorts the elements of a list, in ascending order by default or descending with -1. The right outlet sends the original indexes of the elements in their sorted order."
}