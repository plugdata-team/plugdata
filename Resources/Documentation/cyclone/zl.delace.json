{
  "title": [
    "zl.delace"
  ],
  "description": "de-interleave a list into two lists",
  "origin": "cyclone",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "performs the operation again on the last received list"
        },
        {
          "type": "anything",
          "description": "list to de-interleave"
        }
      ],
      "repeat": false
    },
    {
      "messages": [],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "anything",
          "description": "the 1st, 3rd, 5th... elements"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "anything",
          "description": "the 2nd, 4th, 6th... elements"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [
    {
      "name": "@zlmaxsize <float>",
      "description": "maximum list size, 1 to 32767 (default 256)"
    }
  ],
  "methods": [
    {
      "type": "mode <symbol>",
      "description": "changes the mode, as in [zl]"
    },
    {
      "type": "zlclear",
      "description": "clears the mode's arguments and the data received in both inlets"
    },
    {
      "type": "zlmaxsize <float>",
      "description": "sets the maximum list size, 1 to 32767"
    }
  ],
  "body": "[zl.delace] de-interleaves a list into two lists: the 1st, 3rd, 5th... elements go out the left outlet, and the 2nd, 4th, 6th... ones out the right outlet."
}