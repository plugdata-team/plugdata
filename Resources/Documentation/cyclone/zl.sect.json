{
  "title": [
    "zl.sect"
  ],
  "description": "elements two lists have in common",
  "origin": "cyclone",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "performs the operation again on the last received list"
        },
        {
          "type": "anything",
          "description": "list to intersect"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "anything",
          "description": "list to compare with"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "anything",
          "description": "the elements that are also in the other list"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "bang",
          "description": "when there are no common elements"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "list",
      "description": "list to compare with",
      "default": ""
    }
  ],
  "flags": [
    {
      "name": "@zlmaxsize <float>",
      "description": "maximum list size, 1 to 32767 (default 256)"
    }
  ],
  "methods": [
    {
      "type": "mode <symbol>",
      "description": "changes the mode, as in [zl]"
    },
    {
      "type": "zlclear",
      "description": "clears the mode's arguments and the data received in both inlets"
    },
    {
      "type": "zlmaxsize <float>",
      "description": "sets the maximum list size, 1 to 32767"
    }
  ],
  "body": "[zl.sect] outputs the elements of the input list that are also in another list, set by the arguments or the right inlet. When there are none, the right outlet sends a bang."
}