{
  "title": [
    "zl.unique"
  ],
  "description": "remove given items from a list",
  "origin": "cyclone",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "performs the operation again on the last received list"
        },
        {
          "type": "anything",
          "description": "list to filter"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "anything",
          "description": "items to remove"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "anything",
          "description": "the list without the removed items"
        }
      ],
      "repeat": false
    },
    {
      "messages": [],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "list",
      "description": "items to remove",
      "default": ""
    }
  ],
  "flags": [
    {
      "name": "@zlmaxsize <float>",
      "description": "maximum list size, 1 to 32767 (default 256)"
    }
  ],
  "methods": [
    {
      "type": "mode <symbol>",
      "description": "changes the mode, as in [zl]"
    },
    {
      "type": "zlclear",
      "description": "clears the mode's arguments and the data received in both inlets"
    },
    {
      "type": "zlmaxsize <float>",
      "description": "sets the maximum list size, 1 to 32767"
    }
  ],
  "body": "[zl.unique] removes items from a list: the items to remove are set by the arguments or the right inlet. Unlike [zl.filter], it doesn't output the indexes of the remaining items."
}