{
  "title": [
    "curve~"
  ],
  "description": "curved ramp generator",
  "origin": "cyclone",
  "categories": [
    "Envelopes and LFOs"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "list",
          "description": "up to 42 triplets of target, time in ms and curve factor from -1 to 1"
        },
        {
          "type": "float",
          "description": "jumps there, or ramps if the middle inlet set a time"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "duration in ms, for the next float in the left inlet only"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "curve exponential factor parameter (-1 to 1)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "current value or a ramp towards the target"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "bang",
          "description": "a bang is sent when final target from last ramp is reached"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "initial value",
      "default": "0"
    },
    {
      "type": "float",
      "description": "curve factor from -1 to 1",
      "default": "0 - linear"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "factor <float>",
      "description": "adjusts curve's exponential factor"
    },
    {
      "type": "pause",
      "description": "pauses the output"
    },
    {
      "type": "resume",
      "description": "restores the output after being paused"
    },
    {
      "type": "stop",
      "description": "stops & clears pending targets (still outputs last value)"
    }
  ],
  "body": "Similar to [line~], but [curve~] produces curved (non linear) ramp signals. For example, two triples (of target, time and curve factor) make a simple attack-release envelope."
}