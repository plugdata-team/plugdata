{
  "title": [
    "zl.reg"
  ],
  "description": "store a list",
  "origin": "cyclone",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "outputs the stored list"
        },
        {
          "type": "anything",
          "description": "stores and outputs the list"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "anything",
          "description": "stores the list without output"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "anything",
          "description": "the stored list"
        }
      ],
      "repeat": false
    },
    {
      "messages": [],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "list",
      "description": "initially stored list",
      "default": ""
    }
  ],
  "flags": [
    {
      "name": "@zlmaxsize <float>",
      "description": "maximum list size, 1 to 32767 (default 256)"
    }
  ],
  "methods": [
    {
      "type": "mode <symbol>",
      "description": "changes the mode, as in [zl]"
    },
    {
      "type": "zlclear",
      "description": "clears the mode's arguments and the data received in both inlets"
    },
    {
      "type": "zlmaxsize <float>",
      "description": "sets the maximum list size, 1 to 32767"
    }
  ],
  "body": "[zl.reg] stores a list: the left inlet stores and outputs it, the right inlet only stores it, and a bang outputs it. The arguments set the initially stored list."
}