{
  "title": [
    "gate~"
  ],
  "description": "route a signal to n outlets",
  "origin": "cyclone",
  "categories": [
    "Mixing and Routing"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "outlet number to route to, 0 closes all"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "signal to be routed"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "outlet $nth for routing input signal"
        }
      ],
      "repeat": true
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "'n' number of outlets (1 to 500)",
      "default": "1"
    },
    {
      "type": "float",
      "description": "initial outlet to route to",
      "default": "0 - none"
    }
  ],
  "flags": [],
  "methods": [],
  "body": "[gate~] routes an input signal from the second inlet to one of 'n' specified outlets or none of them. If an outlet is not selected, it outputs zero values."
}