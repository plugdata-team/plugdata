{
  "title": [
    "pix_record"
  ],
  "description": "write a sequence of pixes to a movie file",
  "origin": "Gem",
  "categories": [
    "Graphics"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "gemlist",
          "description": ""
        },
        {
          "type": "bang",
          "description": "grab the next incoming image"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "gemlist",
          "description": ""
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "number of frames written"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "list",
          "description": "info on available codecs/properties"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [],
  "flags": [],
  "methods": [
    {
      "type": "file <symbol>",
      "description": "specify the file for writing"
    },
    {
      "type": "record <float>",
      "description": "start/stop recording"
    },
    {
      "type": "auto <float>",
      "description": "start/stop grabbing all incoming pixes"
    },
    {
      "type": "codeclist",
      "description": "output the list of available codecs on the right outlet"
    },
    {
      "type": "codec <symbol>",
      "description": "select codec by short name"
    },
    {
      "type": "set <symbol, anything>",
      "description": "set a codec property to a value"
    },
    {
      "type": "dialog",
      "description": "popup a dialog to select the codec (if available)"
    },
    {
      "type": "backend <anything>",
      "description": "use only the given backends, in that order"
    },
    {
      "type": "clearProps",
      "description": "forget the properties stored with setProps"
    },
    {
      "type": "clearprops",
      "description": "forget the properties stored with setProps"
    },
    {
      "type": "enumProps",
      "description": "list the properties the backend supports, on the right outlet"
    },
    {
      "type": "proplist",
      "description": "list the properties the backend supports, on the right outlet"
    }
  ],
  "body": ""
}