{
  "title": [
    "scopeXYZ~"
  ],
  "description": "draw three signals as a 3D oscilloscope",
  "origin": "Gem",
  "categories": [
    "Graphics"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "gemlist",
          "description": ""
        },
        {
          "type": "bang",
          "description": "print the stored vertices to the console"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "x-values of the oscilloscope"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "y-values of the oscilloscope"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "z-values of the oscilloscope"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "gemlist",
          "description": ""
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "number of signal points to be stored",
      "default": "blocksize"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "draw <symbol>",
      "description": "drawing style: default, line, linestrip, fill, point, tri, tristrip, trifan, quad or quadstrip"
    },
    {
      "type": "width <float>",
      "description": "line width (default 1)"
    },
    {
      "type": "length <float>",
      "description": "number of signal points to be stored"
    },
    {
      "type": "blend <float>",
      "description": "nonzero turns alpha blending on"
    },
    {
      "type": "linewidth <float>",
      "description": "same as width"
    }
  ],
  "body": ""
}