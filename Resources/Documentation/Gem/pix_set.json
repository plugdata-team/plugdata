    },
    {
      "type": "float",
      "description": "height of the image",
      "default": ""
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "colorspace <symbol>",
      "description": "set format of input-data"
    },
    {
      "type": "fill <list>",
