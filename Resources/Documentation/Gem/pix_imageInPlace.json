{
  "title": [
    "pix_imageInPlace"
  ],
  "description": "loads in multiple image files",
  "origin": "Gem",
  "categories": [
    "Graphics"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "gemlist",
          "description": ""
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "select image (starting at 0)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "gemlist",
          "description": ""
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "symbol",
      "description": "file name pattern, with * where the number goes",
      "default": ""
    },
    {
      "type": "float",
      "description": "first number",
      "default": ""
    },
    {
      "type": "float",
      "description": "last number",
      "default": ""
    },
    {
      "type": "float",
      "description": "step between the numbers",
      "default": "1"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "preload <symbol, float, float, float>",
      "description": "load images: file name with a wildcard *, first number, last number, skip"
    },
    {
      "type": "download",
      "description": "load the \"preload\"ed images into texture-RAM"
    },
    {
      "type": "purge",
      "description": "delete images from texture-RAM"
    },
    {
      "type": "open <symbol, float, float, float>",
      "description": "same as preload"
    },
    {
      "type": "quality <float>",
      "description": "texture filtering: 0 GL_NEAREST, 1 GL_LINEAR"
    },
    {
      "type": "repeat <float>",
      "description": "texture wrapping: 0 clamp to the edge, 1 repeat"
    }
  ],
  "body": ""
}