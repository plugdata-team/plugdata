{
  "title": [
    "gemhead"
  ],
  "description": "start a rendering chain",
  "origin": "Gem",
  "categories": [
    "Graphics"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "nonzero turns rendering of this chain on, 0 off (default 1)"
        },
        {
          "type": "bang",
          "description": "render this chain now"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "gemlist",
          "description": ""
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "priority: lower numbers render first",
      "default": "50"
    },
    {
      "type": "symbol",
      "description": "name of the context (window) to render in",
      "default": ""
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "set <float>",
      "description": "change the priority of this chain"
    },
    {
      "type": "context <symbol>",
      "description": "render into another context (window)"
    }
  ],
  "body": "[gemhead]'s two arguments can come in either order."
}