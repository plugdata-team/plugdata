    {
      "type": "rectangle <float>",
      "description": "nonzero uses rectangle textures if available"
    },
    {
      "type": "repeat <float>",
      "description": "texture wrapping: 0 clamp to the edge, 1 repeat"
    },
    {
      "type": "snap",
      "description": "grab the screen into the texture"
    },
    {
      "type": "texunit <float>",
      "description": "texture unit to bind the texture to (for shaders)"
