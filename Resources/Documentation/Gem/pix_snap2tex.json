        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "gemlist",
          "description": ""
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "list",
          "description": "texture info: ID, x ratio, y ratio, type, upside-down flag"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "x offset of the grabbed area, in pixels",
      "default": "0"
    },
    {
      "type": "float",
      "description": "y offset of the grabbed area, in pixels",
      "default": "0"
