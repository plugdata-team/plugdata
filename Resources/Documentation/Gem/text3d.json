{
  "title": [
    "text3d"
  ],
  "description": "renders a line of text with 3D transformations",
  "origin": "Gem",
  "categories": [
    "Graphics"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "gemlist",
          "description": ""
        },
        {
          "type": "list",
          "description": "render the list as text"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "font size in points (default 20)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "gemlist",
          "description": ""
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "anything",
          "description": "text metrics: bbox, bboxline, ascender, descender, height"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "list",
      "description": "initial text",
      "default": "gem"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "font <symbol>",
      "description": "load a TrueType font"
    },
    {
      "type": "text <list>",
      "description": "render the given text"
    },
    {
      "type": "justify <float, float>",
      "description": "horizontal and vertical justification"
    },
    {
      "type": "string <list>",
      "description": "render the given text as a list of unicode code points (similar to ASCII)"
    },
    {
      "type": "alias <float>",
      "description": "nonzero turns anti-aliasing on (default 1)"
    },
    {
      "type": "antialias <float>",
      "description": "nonzero turns anti-aliasing on (default 1)"
    },
    {
      "type": "linedist <float>",
      "description": "distance between the lines of multi-line text"
    },
    {
      "type": "precision <float>",
      "description": "precision of the glyph outlines"
    }
  ],
  "body": ""
