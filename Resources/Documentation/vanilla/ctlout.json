{
  "title": [
    "ctlout"
  ],
  "description": "MIDI output",
  "origin": "vanilla",
  "categories": [
    "MIDI"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "MIDI controller value"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "MIDI controller number"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "MIDI channel/port"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [],
  "arguments": [
    {
      "type": "float",
      "description": "MIDI controller number",
      "default": "0"
    },
    {
      "type": "float",
      "description": "MIDI channel/port",
      "default": "1"
    }
  ],
  "flags": [],
  "methods": [],
  "body": "[ctlout] sends MIDI control change messages: a value, on the controller number and channel set by the arguments or the right inlets (channel 1 by default). Channels above 16 address further ports: 17 to 32 are channels 1 to 16 of port 2, and so on."
