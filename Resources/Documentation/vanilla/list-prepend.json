{
  "title": [
    "list prepend"
  ],
  "description": "manipulate lists",
  "origin": "vanilla",
  "categories": [
    "Data Management"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "anything",
          "description": "first list: output with the second prepended, a bang is empty"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "anything",
          "description": "second list to prepend, a bang clears it"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "list",
          "description": "the prepended list"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "list",
      "description": "initialize the list to prepend",
      "default": "empty"
    }
  ],
  "flags": [],
  "methods": [],
  "body": "[list prepend] prepends the list in its right inlet to the one in its left inlet and outputs the result. A bang in the left inlet counts as an empty list."
}