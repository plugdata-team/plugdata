{
  "title": [
    "rev2~"
  ],
  "description": "simple 1-in, 4-out reverberator",
  "origin": "vanilla",
  "categories": [
    "Effects"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float/signals",
          "description": "reverb input"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "level in dB"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "liveness (internal feedback %)"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "crossover frequency in Hz"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "high frequency damping in %"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "first reverb output"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "signal",
          "description": "second reverb output"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "signal",
          "description": "third reverb output"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "signal",
          "description": "fourth reverb output"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "level in dB",
      "default": "0"
    },
    {
      "type": "float",
      "description": "liveness / internal feedback %",
      "default": "0"
    },
    {
      "type": "float",
      "description": "crossover frequency in Hz",
      "default": "3000"
    },
    {
      "type": "float",
      "description": "high frequency damping in %",
      "default": "0"
    }
  ],
  "flags": [],
  "methods": [],
  "body": "[rev2~] is a reverberator based on a feedback delay network, with one input and four outputs. The arguments or inlets set the output level in dB, the liveness (the internal feedback, 100 for infinite reverb), the crossover frequency and the high frequency damping: above the crossover, the feedback is reduced by the damping percentage."
}