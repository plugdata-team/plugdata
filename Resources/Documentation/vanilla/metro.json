{
  "title": [
    "metro"
  ],
  "description": "send a message periodically",
  "origin": "vanilla",
  "categories": [
    "Triggers and Clocks"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "start the metronome"
        },
        {
          "type": "float",
          "description": "nonzero starts and zero stops the metronome"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "set metronome time for the next tempo"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "bang",
          "description": "bang at periodic time"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "initial metronome time",
      "default": "1"
    },
    {
      "type": "float",
      "description": "tempo value",
      "default": "1"
    },
    {
      "type": "symbol",
      "description": "time unit",
      "default": "msec"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "stop",
      "description": "stop the metronome"
    },
    {
      "type": "tempo <float, symbol>",
      "description": "set tempo value and time unit"
    }
  ],
  "body": "[metro] sends bangs at regular time intervals. A bang or nonzero float starts it, and 0 or 'stop' stops it. The interval is set by the argument or the right inlet, in milliseconds by default, which the 'tempo' message or the 2nd and 3rd arguments can change."
}