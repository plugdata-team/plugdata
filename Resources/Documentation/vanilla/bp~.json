{
  "title": [
    "bp~"
  ],
  "description": "2-pole bandpass filter",
  "origin": "vanilla",
  "categories": [
    "Filters"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float/signal",
          "description": "input signal to be filtered"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "center frequency in Hz"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "Q (controls bandwidth)"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signal",
          "description": "the filtered signal output"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "initial center frequency in Hz",
      "default": "0"
    },
    {
      "type": "float",
      "description": "initial Q",
      "default": "0"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "clear",
      "description": "clear filter's memory"
    }
  ],
  "body": "[bp~] is a 2-pole bandpass filter: it passes a sinusoid at the center frequency at about unit gain and attenuates other frequencies. The middle inlet sets the center frequency and the right one the Q; the higher the Q, the narrower the band. The center frequency can be at most the sample rate divided by 6.28; for a more general filter, try [vcf~]."
}