{
  "title": [
    "sig~"
  ],
  "description": "convert numbers to signals",
  "origin": "vanilla",
  "categories": [
    "Signal Math",
    "Data Math",
    "Signal Generators"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "number to convert to signal"
        }
      ],
      "repeat": true
    }
  ],
  "outlets": [
    {
      "messages": [
        {
          "type": "signals",
          "description": "converted signal"
        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "float",
      "description": "initially converted value",
      "default": ""
    }
  ],
  "flags": [],
  "methods": [],
  "body": "[sig~] converts a float to a signal. Its value can only change once per block; for changes in between blocks, use [vline~]."
}