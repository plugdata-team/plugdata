        }
      ],
      "repeat": false
    }
  ],
  "arguments": [
    {
      "type": "list",
      "description": "channels to be picked",
      "default": "empty list"
    }
  ],
  "flags": [],
  "methods": [
    {
      "type": "channels <list>",
      "description": "update channels to be picked (updates DSP)"
    }
  ],
  "body": "[snake_pick~] is what [snake~ pick] creates."
