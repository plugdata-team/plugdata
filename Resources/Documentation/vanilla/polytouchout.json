{
  "title": [
    "polytouchout"
  ],
  "description": "MIDI output",
  "origin": "vanilla",
  "categories": [
    "MIDI"
  ],
  "inlets": [
    {
      "messages": [
        {
          "type": "float",
          "description": "MIDI aftertouch value"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "MIDI note number"
        }
      ],
      "repeat": false
    },
    {
      "messages": [
        {
          "type": "float",
          "description": "MIDI channel/port"
        }
      ],
      "repeat": false
    }
  ],
  "outlets": [],
  "arguments": [
    {
      "type": "float",
      "description": "channel/port",
      "default": "1"
    }
  ],
  "flags": [],
  "methods": [],
  "body": "[polytouchout] sends MIDI polyphonic aftertouch: a value for a note number, on the channel set by the argument or the right inlet. Channels above 16 address further ports: 17 to 32 are channels 1 to 16 of port 2, and so on."
}